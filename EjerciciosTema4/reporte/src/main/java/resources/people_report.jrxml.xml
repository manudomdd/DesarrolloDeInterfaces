<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="reportePersonas" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <parameter name="paramNombre" class="java.lang.String" isForPrompting="true">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <parameter name="paramEdad" class="java.lang.Integer" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[SELECT * FROM persona WHERE nombre LIKE CONCAT('%', $P{paramNombre}, '%') AND ($P{paramEdad} IS NULL OR edad = $P{paramEdad})]]>
    </queryString>

    <field name="id" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="edad" class="java.lang.Integer"/>

    <background>
        <band/>
    </background>

    <title>
        <band height="72">
            <frame>
                <reportElement mode="Opaque" x="-20" y="-20" width="595" height="92" backcolor="#006699"/>
                <staticText>
                    <reportElement x="20" y="20" width="350" height="43" forecolor="#FFFFFF"/>
                    <textElement>
                        <font size="34" isBold="true"/>
                    </textElement>
                    <text><![CDATA[LISTADO]]></text>
                </staticText>
                <staticText>
                    <reportElement x="395" y="43" width="180" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right">
                        <font size="14" isBold="false"/>
                    </textElement>
                    <text><![CDATA[Reporte con Edad]]></text>
                </staticText>
            </frame>
        </band>
    </title>

    <columnHeader>
        <band height="21">
            <line>
                <reportElement x="-20" y="20" width="595" height="1" forecolor="#666666"/>
            </line>
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="80" height="20" forecolor="#006699" backcolor="#E6E6E6"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="80" y="0" width="375" height="20" forecolor="#006699" backcolor="#E6E6E6"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[NOMBRE]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="455" y="0" width="100" height="20" forecolor="#006699" backcolor="#E6E6E6"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[EDAD]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="19" width="555" height="1"/>
            </line>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="90" y="0" width="365" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="455" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{edad}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="17">
            <textField>
                <reportElement mode="Opaque" x="0" y="4" width="515" height="13" backcolor="#E6E6E6"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página "+$V{PAGE_NUMBER}+" de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement mode="Opaque" x="515" y="4" width="40" height="13" backcolor="#E6E6E6"/>
                <textElement/>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="400">
             <barChart>
                <chart evaluationTime="Report">
                    <reportElement x="0" y="20" width="555" height="350"/>
                    <chartTitle>
                        <titleExpression><![CDATA["Edad por Persona"]]></titleExpression>
                    </chartTitle>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Edad"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{nombre} + " (" + $F{id} + ")"]]></categoryExpression>
                        <valueExpression><![CDATA[$F{edad}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot isShowTickLabels="true" isShowTickMarks="true">
                    <plot orientation="Horizontal"/>
                    <itemLabel/>
                </barPlot>
            </barChart>
        </band>
    </summary>
</jasperReport>